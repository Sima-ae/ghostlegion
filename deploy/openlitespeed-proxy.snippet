# CyberPanel / OpenLiteSpeed — proxy ghostlegion.online → Next.js :3017
# Applied by scripts/configure-litespeed-ghostlegion.sh

extprocessor ghostlegion_3017 {
  type                    proxy
  address                 127.0.0.1:3017
  maxConns                100
  pcKeepAliveTimeout      60
  initTimeout             60
  retryTimeout            0
  respBuffer              0
}

context /.well-known/acme-challenge/ {
  type                    static
  location                /home/ghostlegion.online/public_html/.well-known/acme-challenge/
  allowBrowse             1
  addDefaultCharset       off
}

context / {
  type                    proxy
  handler                 ghostlegion_3017
  addDefaultCharset       off
}
