# Local development — copy to .env.local and fill in real values.
# Never commit .env.local.

NODE_ENV=development
PORT=3000

# Use CHANGE_ME as a placeholder. Put the real password only in .env.local.
DATABASE_URL=mysql://ghos_t_legion_online:CHANGE_ME@127.0.0.1:3307/ghos_t_legion_online

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — required by scripts/seed-admin.js and npm run db:sql
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
