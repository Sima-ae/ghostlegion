# Production VPS (89.116.38.197) — copy to /var/www/ghostlegion/shared/.env
# IMPORTANT: only KEY=VALUE lines (no shell commands).
#
# Database user + name from CyberPanel: ghos_t_legion_online
# Port 3017 is reserved for this app (catalogus=3001, toyotas=3009, etc.)

NODE_ENV=production
PORT=3017

NEXT_PUBLIC_SITE_URL=https://ghostlegion.online
NEXT_PUBLIC_APP_URL=https://ghostlegion.online
NEXTAUTH_URL=https://ghostlegion.online
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# MariaDB on the same VPS — use 127.0.0.1 (never expose publicly)
DATABASE_URL=mysql://ghos_t_legion_online:CHANGE_ME@127.0.0.1:3306/ghos_t_legion_online
